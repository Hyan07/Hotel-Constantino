# Aplicação
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=false

# Banco local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=constantinos_hotel_dev
DB_USER=constantinos_dev
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_SSL=false

# Sessão e autenticação
SESSION_SECRET=
SESSION_COOKIE_NAME=constantinos.sid
SESSION_TTL_HOURS=8
DEV_AUTH_BYPASS=true

# Bootstrap administrativo temporário (comando admin:create ou primeira inicialização gerenciada)
ADMIN_BOOTSTRAP_ENABLED=false
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
