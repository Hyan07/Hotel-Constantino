{
  "name": "constantinos-hotel",
  "version": "2.0.0-alpha.2",
  "private": true,
  "description": "Monorepo profissional do sistema de gestão do Constantino's Hotel.",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names BACKEND,FRONTEND --prefix-colors blue,green \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "build": "npm run build --workspace frontend",
    "release:build": "npm run build && npm run db:migrate",
    "start": "npm run start --workspace backend",
    "env:check": "npm run env:check --workspace backend",
    "db:check": "npm run db:check --workspace backend",
    "db:status": "npm run db:status --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "db:reset": "npm run db:reset --workspace backend --",
    "admin:create": "npm run admin:create --workspace backend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace backend",
    "check": "npm run lint && npm run format:check && npm test && npm run build"
  },
  "keywords": [
    "hotel",
    "gestao-hoteleira",
    "nodejs",
    "express",
    "mysql",
    "monorepo"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
